{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyphshift",
  "version": "0.2.0",
  "identifier": "app.glyphshift.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glyphshift",
        "width": 1180,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "center": true
      },
      {
        "label": "interactive-translation-bubble",
        "title": "Glyphshift translation",
        "url": "index.html?surface=translation-bubble",
        "width": 420,
        "height": 210,
        "resizable": false,
        "decorations": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
